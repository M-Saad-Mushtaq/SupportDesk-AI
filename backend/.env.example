# No keys required in default mock mode. This file is documentation, not auto-loaded.
# Default SQLite file: backend/supportdesk.db (independent of working directory).
# Optional override; set in PowerShell before migrations, seed, and server startup:
# $env:DATABASE_URL = 'sqlite:///C:/absolute/path/supportdesk.db'
# Environment files are NOT loaded automatically. The parent directory must exist.
# Keep future secrets only on the backend, in ignored local configuration.
# Optional private upload folder (default: backend/uploads):
# $env:UPLOAD_DIR = 'C:/absolute/private/uploads'
# Keep it excluded from Git and outside frontend; move existing stored files if changed.


# Set these in the backend PowerShell process; never in frontend/VITE variables.
AI_PROVIDER=mock
AI_MODEL=mock-support-v1
# Optional live model: gemini-3.8-flash. Only after checking an unpaid project:
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
# Defaults and allowed inclusive ranges:
AI_REQUEST_TIMEOUT=20
# 1..60 seconds
AI_TURN_TIMEOUT=60
# 5..180 seconds
AI_MAX_OUTPUT_TOKENS=1024
# 128..4096 per request
AI_MAX_REQUESTS=4
# 1..8 per attempt
AI_MAX_TOOL_CALLS=6
# 1..12 per attempt
AI_MAX_CONTEXT_CHARS=24000
# 8000..48000 including continuations
AI_MAX_HISTORY_MESSAGES=16
# 1..30 whole public messages; internal notes excluded
AI_MAX_ATTEMPTS=3
# 1..5 total attempts; retries are explicit, never automatic
